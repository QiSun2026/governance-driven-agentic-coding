{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisun2026.github.io/governance-driven-agentic-coding/practice-kit/schemas/eval-plan.schema.json",
  "title": "GDAC v2.0 Eval Plan",
  "description": "A frozen claim-and-risk-to-evidence plan for work governed by the GDAC Harness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "eval_plan_id",
    "status",
    "contract_ref",
    "risk_tier",
    "risk_overlays",
    "subject",
    "baseline",
    "claims",
    "evals",
    "reporting"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "revision": {"type": "integer", "minimum": 1},
    "eval_plan_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "status": {"enum": ["draft", "frozen", "retired"]},
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "revision", "sha256"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 3},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "risk_tier": {"enum": ["low", "medium", "high"]},
    "risk_overlays": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[a-z0-9][a-z0-9._-]+$"
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "selection_rule", "binding_rule", "change_invalidation"],
      "properties": {
        "description": {"type": "string", "minLength": 10},
        "selection_rule": {"type": "string", "minLength": 10},
        "binding_rule": {"const": "exact-candidate-reference-required-at-evaluation"},
        "change_invalidation": {"const": "new-version-and-rerun"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regression_applicable", "rationale"],
      "properties": {
        "regression_applicable": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 8}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "material"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "statement": {"type": "string", "minLength": 8},
          "material": {"type": "boolean"}
        }
      }
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eval_id",
          "claim_ids",
          "risk_ids",
          "eval_class",
          "grader",
          "producer_constraints",
          "procedure",
          "pass_rule",
          "required_evidence",
          "risk_trigger",
          "conflict_rule",
          "max_evaluator_reruns",
          "trial_policy",
          "blocking",
          "insufficient_action"
        ],
        "properties": {
          "eval_id": {"type": "string", "minLength": 3},
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3}
          },
          "risk_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3}
          },
          "eval_class": {
            "enum": ["contract", "capability", "regression", "adversarial", "security", "privacy", "governance"]
          },
          "grader": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "configuration_ref", "calibration_ref", "qualification_ref"],
            "properties": {
              "type": {"enum": ["deterministic", "rule", "model", "human"]},
              "name": {"type": "string", "minLength": 3},
              "configuration_ref": {"type": ["string", "null"], "minLength": 3},
              "calibration_ref": {"type": ["string", "null"], "minLength": 3},
              "qualification_ref": {"type": ["string", "null"], "minLength": 3}
            }
          },
          "producer_constraints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["producer_role", "allowed_grader_roles", "prohibited_grader_roles", "separation_requirement"],
            "properties": {
              "producer_role": {"type": "string", "minLength": 2},
              "allowed_grader_roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 2}
              },
              "prohibited_grader_roles": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 2}
              },
              "separation_requirement": {"enum": ["none", "context", "party"]}
            }
          },
          "procedure": {"type": "string", "minLength": 8},
          "pass_rule": {"type": "string", "minLength": 5},
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "deterministic_test",
                "regression_test",
                "rule_check",
                "adversarial_result",
                "security_check",
                "privacy_check",
                "model_grade",
                "human_review",
                "external_source",
                "clean_clone",
                "diff",
                "log"
              ]
            }
          },
          "risk_trigger": {"type": "string", "minLength": 5},
          "conflict_rule": {"const": "unresolved-contradiction-is-insufficient-evidence"},
          "max_evaluator_reruns": {"type": "integer", "minimum": 0, "maximum": 20},
          "trial_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "k", "retain_all_trials", "independence_rule", "selection_rule"],
            "properties": {
              "kind": {"enum": ["single", "pass-at-k", "pass-power-k"]},
              "k": {"type": "integer", "minimum": 1, "maximum": 100},
              "retain_all_trials": {"const": true},
              "independence_rule": {"type": ["string", "null"], "minLength": 8},
              "selection_rule": {"const": "all-declared-trials-count"}
            },
            "allOf": [
              {
                "if": {"properties": {"kind": {"const": "single"}}, "required": ["kind"]},
                "then": {
                  "properties": {"k": {"const": 1}, "independence_rule": {"type": "null"}}
                }
              },
              {
                "if": {"properties": {"kind": {"enum": ["pass-at-k", "pass-power-k"]}}, "required": ["kind"]},
                "then": {
                  "properties": {"k": {"minimum": 2}, "independence_rule": {"type": "string", "minLength": 8}}
                }
              }
            ]
          },
          "blocking": {"type": "boolean"},
          "insufficient_action": {"const": "block"}
        },
        "anyOf": [
          {"properties": {"claim_ids": {"minItems": 1}}},
          {"properties": {"risk_ids": {"minItems": 1}}}
        ]
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_evidence_references",
        "retain_all_attempts",
        "retain_inputs",
        "retain_raw_outputs",
        "redaction_required",
        "redaction_basis",
        "retention_period",
        "record_tokens",
        "record_cost"
      ],
      "properties": {
        "retain_evidence_references": {"const": true},
        "retain_all_attempts": {"const": true},
        "retain_inputs": {"type": "boolean"},
        "retain_raw_outputs": {"type": "boolean"},
        "redaction_required": {"type": "boolean"},
        "redaction_basis": {"type": "string", "minLength": 8},
        "retention_period": {"type": "string", "minLength": 3},
        "record_tokens": {"enum": ["required", "when-observable", "not-applicable"]},
        "record_cost": {"enum": ["required", "when-observable", "not-applicable"]}
      }
    }
  }
}
