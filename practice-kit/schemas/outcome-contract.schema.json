{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisun2026.github.io/governance-driven-agentic-coding/schemas/outcome-contract.schema.json",
  "title": "GDAC Outcome Contract",
  "description": "A bounded contract for material work delegated to AI agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "status",
    "outcome",
    "acceptance_criteria",
    "non_goals",
    "risk_tier",
    "authority",
    "budget",
    "stop_conditions",
    "evidence_requirements",
    "handoff"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_id": {"type": "string", "minLength": 3, "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "status": {"enum": ["draft", "frozen", "closed"]},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "accepted_by"],
      "properties": {
        "statement": {"type": "string", "minLength": 10},
        "accepted_by": {"type": "string", "minLength": 2}
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "description", "grader"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 3},
          "description": {"type": "string", "minLength": 8},
          "grader": {"enum": ["deterministic", "rule", "model", "human", "owner"]}
        }
      }
    },
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "risk_tier": {"enum": ["low", "medium", "high", "regulated-overlay"]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "roles"],
      "properties": {
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_id", "reserved_decisions"],
          "properties": {
            "owner_id": {"type": "string", "minLength": 2},
            "reserved_decisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role_id", "can_write", "forbidden_actions"],
            "properties": {
              "role_id": {"type": "string", "minLength": 2},
              "can_write": {"type": "array", "items": {"type": "string"}},
              "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_elapsed_minutes", "max_retries", "max_agent_depth", "token_budget"],
      "properties": {
        "max_elapsed_minutes": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0},
        "max_agent_depth": {"type": "integer", "minimum": 0},
        "token_budget": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "required_types", "insufficient_action"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "required_types": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["deterministic_test", "rule_check", "model_grade", "human_review", "owner_decision", "external_source"]}
          },
          "insufficient_action": {"enum": ["block", "owner-decision-required"]}
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_outputs"],
      "properties": {
        "required_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      }
    }
  }
}
