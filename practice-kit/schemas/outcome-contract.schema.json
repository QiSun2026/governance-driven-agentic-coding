{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisun2026.github.io/governance-driven-agentic-coding/practice-kit/schemas/outcome-contract.schema.json",
  "title": "GDAC v2.0 Outcome Contract",
  "description": "A pre-work contract that fixes the result, authority, budgets, risks, stop conditions, and technical evidence required for material work delegated to AI agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "contract_id",
    "status",
    "outcome",
    "acceptance_criteria",
    "non_goals",
    "risk_tier",
    "risk_overlays",
    "risks",
    "authority",
    "budget",
    "stop_conditions",
    "evidence_requirements",
    "handoff"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "revision": {"type": "integer", "minimum": 1},
    "contract_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "status": {"enum": ["draft", "frozen", "closed"]},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": {"type": "string", "minLength": 10}
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "criterion_kind", "description", "grader"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 3},
          "criterion_kind": {"const": "technical"},
          "description": {"type": "string", "minLength": 8},
          "grader": {"enum": ["deterministic", "rule", "model", "human"]}
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {"type": "string", "minLength": 3}
    },
    "risk_tier": {"enum": ["low", "medium", "high"]},
    "risk_overlays": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[a-z0-9][a-z0-9._-]+$"
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_id", "description", "material"],
        "properties": {
          "risk_id": {"type": "string", "minLength": 3},
          "description": {"type": "string", "minLength": 8},
          "material": {"type": "boolean"}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "roles"],
      "properties": {
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_id", "reserved_decisions"],
          "properties": {
            "owner_id": {"type": "string", "minLength": 2},
            "reserved_decisions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 3}
            }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role_id",
              "principal_id",
              "context_ref",
              "can_write",
              "forbidden_actions"
            ],
            "properties": {
              "role_id": {"type": "string", "minLength": 2},
              "principal_id": {"type": "string", "minLength": 2},
              "context_ref": {"type": "string", "minLength": 2},
              "can_write": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "forbidden_actions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 3}
              }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_elapsed_minutes",
        "max_build_retries",
        "max_total_eval_reruns",
        "max_total_trials",
        "max_agent_depth",
        "token_budget"
      ],
      "properties": {
        "max_elapsed_minutes": {"type": "integer", "minimum": 1},
        "max_build_retries": {"type": "integer", "minimum": 0, "maximum": 20},
        "max_total_eval_reruns": {"type": "integer", "minimum": 0, "maximum": 100},
        "max_total_trials": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_agent_depth": {"type": "integer", "minimum": 0, "maximum": 10},
        "token_budget": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5}
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "required_types", "insufficient_action"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "required_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "deterministic_test",
                "regression_test",
                "rule_check",
                "adversarial_result",
                "security_check",
                "privacy_check",
                "model_grade",
                "human_review",
                "external_source",
                "clean_clone",
                "diff",
                "log"
              ]
            }
          },
          "insufficient_action": {"const": "block"}
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_outputs"],
      "properties": {
        "required_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
